{
  "name": "@dsh-remote/test-fakes",
  "version": "0.0.0",
  "private": true,
  "description": "Shared in-memory fakes for dsh-remote daemon-protocol tests (FakeBackendBroker, FakeTargetConnector, FakeRemoteHub, e2e host fakes and the real-BackendServer rig); not published",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dsh-remote/backend": "workspace:*",
    "@dsh-remote/core": "workspace:*",
    "@dsh-remote/remote": "workspace:*",
    "@dsh-remote/seams": "workspace:*",
    "@dsh-remote/test-utils": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
